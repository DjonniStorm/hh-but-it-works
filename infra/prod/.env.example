# Скопировать в infra/prod/.env (он в .gitignore) и заполнить.
# Секреты генерировать на сервере: openssl rand -hex 32

# Домен стенда. A-запись должна смотреть на сервер до первого запуска:
# Caddy сразу пойдёт за сертификатом Let's Encrypt.
DOMAIN=hh.example.ru
# Поддомен мока ФСП: вход через ФСП и Swagger мока (/docs). Своя A-запись на тот же сервер.
FSP_DOMAIN=fsp-mock.example.ru
# Поддомен документации (docs/prod). Своя A-запись на тот же сервер.
DOCS_DOMAIN=docs.example.ru
# Почта для Let's Encrypt (предупреждения об истечении сертификата).
ACME_EMAIL=admin@example.ru

# Postgres. Пароль попадает в DATABASE_URL: только буквы и цифры (openssl rand -hex 24).
POSTGRES_USER=hh
POSTGRES_PASSWORD=
POSTGRES_DB=hh

# JWT: два разных случайных значения. Смена разлогинивает всех.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Почта. SMTP Яндекса: логин ящика и пароль приложения, не пароль от аккаунта.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Отправитель, по умолчанию SMTP_USER. Яндекс принимает только свой адрес.
MAIL_FROM=

# production закрывает вход под сид-кандидатами и не пишет ссылку подтверждения в лог.
NODE_ENV=production
# Работает только при NODE_ENV не production: пароль для seed.b101@candidates.hh.test и др.
SEED_CANDIDATE_PASSWORD=
# Демо-аккаунты (infra/README.md): пароль для 3 работодателей и 2 кандидатов, работает и в production.
# Пусто: вход под ними закрыт.
DEMO_PASSWORD=

# Лимит на вход, регистрацию и письма подтверждения: столько POST с одного IP за окно.
AUTH_RATE_EVENTS=10
AUTH_RATE_WINDOW=1m

# Порты Caddy на хосте. На сервере оставить 80 и 443: на них приходит Let's Encrypt.
# HTTP_PORT=80
# HTTPS_PORT=443

# Ссылка в письмах, по умолчанию https://$DOMAIN.
# WEB_URL=
# Адрес мока для кнопки входа через ФСП, по умолчанию https://$FSP_DOMAIN. Вшивается в бандл web.
# FSP_PUBLIC_URL=
