{
  "name": "hh-but-it-works",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write --ignore-unknown .",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @hh/api --filter @hh/web build",
    "test": "pnpm --filter @hh/api --filter @hh/web test",
    "dev:web": "pnpm --filter @hh/web dev",
    "dev:api": "pnpm --filter @hh/api dev",
    "openapi": "pnpm --filter @hh/contracts build && pnpm --filter @hh/api openapi && pnpm exec openapi-ts",
    "start:mock": "bun run apps/mock/src/index.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hey-api/openapi-ts": "^0.99.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
