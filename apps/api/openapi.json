  "info": {
    "title": "HH API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": ["candidate", "employer"]
          },
          "consent": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["email", "password", "role", "consent"]
      },
      "PublicUserDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "role": {
            "type": "string",
            "enum": ["candidate", "employer"]
          },
          "emailVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          }
        },
        "required": ["id", "email", "role", "emailVerifiedAt"],
        "additionalProperties": false
      },
      "ConfirmEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["token"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["email", "password"]
      },
      "SessionDto_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "role": {
                "type": "string",
                "enum": ["candidate", "employer"]
              },
              "emailVerifiedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "nullable": true
              }
            },
            "required": ["id", "email", "role", "emailVerifiedAt"],
            "additionalProperties": false
          }
        },
        "required": ["accessToken", "refreshToken", "user"],
        "additionalProperties": false
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["refreshToken"]
      },
      "CandidateProfileDto_Output": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "specialization": {
            "type": "string",
            "enum": ["backend", "frontend", "data", "security", null],
            "nullable": true
          },
          "claimedGrade": {
            "type": "string",
            "enum": ["junior", "middle", "senior", null],
            "nullable": true
          },
          "fspId": {
            "type": "string",
            "maxLength": 64,
            "nullable": true
          },
          "telegram": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          },
          "github": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          },
          "linkedin": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          },
          "website": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          },
          "listed": {
            "type": "boolean"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skillId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "slug": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "level": {
                  "type": "string",
                  "enum": ["basic", "confident", "strong", null],
                  "nullable": true
                },
                "verification": {
                  "type": "string",
                  "enum": ["unverified", "verified", "verified_external", null],
                  "nullable": true
                }
              },
              "required": ["skillId", "slug", "title", "level", "verification"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "displayName",
          "specialization",
          "claimedGrade",
          "fspId",
          "telegram",
          "github",
          "linkedin",
          "website",
          "listed",
          "skills"
        ],
        "additionalProperties": false
      },
      "SaveProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "specialization": {
            "type": "string",
            "enum": ["backend", "frontend", "data", "security"]
          },
          "claimedGrade": {
            "type": "string",
            "enum": ["junior", "middle", "senior"]
          },
          "fspId": {
            "type": "string",
            "maxLength": 64
          },
          "telegram": {
            "type": "string",
            "maxLength": 120
          },
          "github": {
            "type": "string",
            "maxLength": 120
          },
          "linkedin": {
            "type": "string",
            "maxLength": 120
          },
          "website": {
            "type": "string",
            "maxLength": 120
          },
          "skills": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "skillId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "level": {
                      "type": "string",
                      "enum": ["basic", "confident", "strong", null],
                      "nullable": true
                    }
                  },
                  "required": ["skillId", "level"]
                },
                {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "level": {
                      "type": "string",
                      "enum": ["basic", "confident", "strong", null],
                      "nullable": true
                    }
                  },
                  "required": ["title", "level"]
                }
              ]
            }
          }
        },
        "required": [
          "displayName",
          "specialization",
          "claimedGrade",
          "fspId",
          "telegram",
          "github",
          "linkedin",
          "website",
          "skills"
        ]
      }
    }
  }
}
