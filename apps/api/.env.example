PORT=3000
DATABASE_URL=postgres://hh:hh@localhost:5432/hh
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
WEB_URL=http://localhost:5173
FSP_URL=http://localhost:3001
RANKING_URL=http://localhost:8000
# Только для разработки: пароль для входа под сид-кандидатами (seed.b101@candidates.hh.test и т. д.).
# Раскомментируйте локально. В production (NODE_ENV=production) игнорируется.
# SEED_CANDIDATE_PASSWORD=seed-candidate
# Почта, SMTP_HOST обязателен. Mailpit из infra/dev (письма видно на http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
# Настоящая отправка через Яндекс: логин ящика и пароль приложения, не пароль от аккаунта.
# Значения держите только в своём .env, в репозиторий не коммитьте.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# Отправитель, по умолчанию SMTP_USER. Яндекс принимает только свой адрес.
# MAIL_FROM=
